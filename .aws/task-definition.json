{
  "family": "ecommerce-task",
  "networkMode": "awsvpc",
  "executionRoleArn": "arn:aws:iam::578620462075:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "Main",
      "image": "578620462075.dkr.ecr.us-east-1.amazonaws.com/ecommerce-app:latest",
      "cpu": 0,
      "essential": true,
      "portMappings": [
        {
          "containerPort": 5000,
          "hostPort": 5000,
          "protocol": "tcp",
          "name": "main-80-tcp",
          "appProtocol": "http"
        }
      ]
    }
  ],
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512"
}